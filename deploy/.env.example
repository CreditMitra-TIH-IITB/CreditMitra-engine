# Copy to deploy/.env. Never commit the real file.

# Shared secret between the engine and the merchant server (required).
MERCHANT_API_KEY=change-me

# Encrypts borrower results at rest (required). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep a copy somewhere safe: without it, stored results cannot be read.
TASK_ENCRYPTION_KEY=
# Results older than this many days are deleted (0 keeps them forever).
RESULT_RETENTION_DAYS=30

# Where the engine finds Ollama. Default: the host's Ollama.
# With `--profile ollama`, use the container instead:
# OLLAMA_HOST=http://ollama:11434
OLLAMA_HOST=http://host.docker.internal:11434

# Optional: the merchant server's curation loop (web search + LLM). Without
# these it abstains on everything. Promotion needs a name in at least
# MERCHANT_MIN_STATEMENT_COUNT distinct statements.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
LANGSEARCH_API_KEY=
MERCHANT_MIN_STATEMENT_COUNT=3

# Directory holding payee-q8_0.gguf, for the containerised Ollama only.
PAYEE_GGUF_DIR=../../outputs
